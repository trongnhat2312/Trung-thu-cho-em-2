  m_FontData:
    m_Font: {fileID: 12800000, guid: 6862a62598c546a4ab5ca6498b256917, type: 3}
    m_FontSize: 39
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 0
    m_MaxSize: 45
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1
  m_Text: "Ch\xE0o m\u1EEBng b\u1EA1n \u0111\u1EBFn v\u1EDBi B\u1EA3o t\xE0ng \nD\xE2n
    t\u1ED9c h\u1ECDc Vi\u1EC7t Nam!\n\nCh\u1EAFc h\u1EB3n ch\xFAng ta \u0111\u1EC1u
    \u0111\u01B0\u1EE3c nghe k\u1EC3 chuy\u1EC7n v\u1EC1 Th\xE1nh Gi\xF3ng r\u1ED3i
    \u0111\xFAng kh\xF4ng. Trong \u0111\xF3 c\xF3 ch\xFA ng\u1EF1a s\u1EAFt phun
    ra l\u1EEDa, v\u1EDBi s\u1EE9c m\u1EA1nh phi ph\xE0m!\nNh\u01B0ng s\u1EE9c m\u1EA1nh
    kh\xF4ng ch\u1EC9 \u0111\u1EBFn t\u1EEB s\u1EAFt th\xE9p, m\xE0 c\xF2n t\u1EEB
    nh\u1EEFng ph\u1EA9m ch\u1EA5t l\xE0m n\xEAn m\u1ED9t b\u1EADc anh h\xF9ng!\nXu\xE2n
    B\xEDnh Ng\u1ECD n\xE0y, ch\xFAng ta h\xE3y t\xECm ki\u1EBFm nh\u1EEFng ph\u1EA9m
    ch\u1EA5t \u0111\xF3 qua tr\xF2 ch\u01A1i Kh\xE1m ph\xE1 c\xE1c hi\u1EC7n v\u1EADt
    v\u1EC1 ng\u1EF1a trong B\u1EA3o t\xE0ng nh\xE9!"
