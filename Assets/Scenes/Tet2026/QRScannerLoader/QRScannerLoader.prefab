    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "D\xE2y c\u01B0\u01A1ng - CH\u0102M CH\u1EC8 & KI\xCAN NH\u1EAAN\nKh\xF4ng
    ph\u1EA3i ai \u0111i nhanh h\u01A1n c\u0169ng \u0111\u1EBFn \u0111\xEDch tr\u01B0\u1EDBc.
    Ch\u0103m ch\u1EC9 v\xE0 ki\xEAn nh\u1EABn gi\xFAp ch\xFAng ta ti\u1EBFn t\u1EEBng
    b\u01B0\u1EDBc v\u1EEFng v\xE0ng, \u0111\u1EC3 m\u1ED7i h\xE0nh tr\xECnh \u0111\u1EC1u
    l\xE0 m\u1ED9t qu\xE1 tr\xECnh tr\u01B0\u1EDFng th\xE0nh."
