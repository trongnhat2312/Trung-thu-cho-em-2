    - target: {fileID: 5541999641889772925, guid: 0859b6a056f8847b1b58a5cc2dd99f38,
        type: 3}
      propertyPath: m_Text
      value: "Burad - Ng\u1EF1a \u0111\u01B0a Muhammad t\u1EEB Mecca \u0111\u1EBFn
        Jerusalem"
      objectReference: {fileID: 0}
    - target: {fileID: 5564481573256998143, guid: 0859b6a056f8847b1b58a5cc2dd99f38,
        type: 3}
      propertyPath: m_Text
      value: "Buraq (Burad) l\xE0 m\u1ED9t linh th\xFA trong truy\u1EC1n thuy\u1EBFt
        IslamH\u1ED3i gi\xE1o, \u0111\u01B0\u1EE3c m\xF4 t\u1EA3 c\xF3 th\xE2n ng\u1EF1a
        nh\u01B0ng c\xF3 c\xE1nh, khu\xF4n m\u1EB7t ng\u01B0\u1EDDi, c\xF3 th\u1EC3
        bay nhanh nh\u01B0 ch\u1EDBp.  Buraq \u0111\u01B0a nh\xE0 ti\xEAn tri Muhammad
        \u0111i m\u1ED9t h\xE0nh tr\xECnh k\u1EF3 di\u1EC7u t\u1EEB Mecca) \u0111\u1EBFn
        Jerusalem.  T\u1EA1i \u0110\xF4ng Java (Indonesia), Buraq xu\u1EA5t hi\u1EC7n
        trong ngh\u1EC7 thu\u1EADt d\xE2n gian Islam H\u1ED3i gi\xE1o v\u1EDBi phong
        c\xE1ch b\u1EA3n \u0111\u1ECBa, ph\u1EA3n \xE1nh s\u1EF1 giao thoa v\u0103n
        h\xF3a v\xE0 bi\u1EC3u tr\u01B0ng cho h\xE0nh tr\xECnh thi\xEAng li\xEAng,
        \u0111\u1EE9c tin v\xE0 s\u1EF1 k\u1EBFt n\u1ED1i gi\u1EEFa tr\u1EA7n t\u1EE5c
        v\u1EDBi c\xF5i thi\xEAng."
      objectReference: {fileID: 0}
    - target: {fileID: 6666674956039170463, guid: 0859b6a056f8847b1b58a5cc2dd99f38,
        type: 3}
      propertyPath: m_Name
      value: PlaceInfo_Root_Unlock_new2026
