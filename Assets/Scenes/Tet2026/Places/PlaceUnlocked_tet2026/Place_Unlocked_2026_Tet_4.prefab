    - target: {fileID: 5541999641889772925, guid: 0859b6a056f8847b1b58a5cc2dd99f38,
        type: 3}
      propertyPath: m_Text
      value: "Con ng\u1EF1a trong m\xFAa r\u1ED1i d\xE2y"
      objectReference: {fileID: 0}
    - target: {fileID: 5541999641889772925, guid: 0859b6a056f8847b1b58a5cc2dd99f38,
        type: 3}
      propertyPath: m_FontData.m_MaxSize
      value: 57
      objectReference: {fileID: 0}
    - target: {fileID: 5564481573256998143, guid: 0859b6a056f8847b1b58a5cc2dd99f38,
        type: 3}
      propertyPath: m_Text
      value: "Trong ngh\u1EC7 thu\u1EADt r\u1ED1i d\xE2y truy\u1EC1n th\u1ED1ng Myanmar
        (Yoke Th\xE9), h\xECnh th\xE0nh t\u1EEB th\u1EBF k\u1EF7 XV v\xE0 \u0111\u1EA1t
        \u0111\u1EC9nh cao v\xE0o th\u1EBF k\u1EF7 XIX, ng\u1EF1a (Myin) l\xE0 nh\xE2n
        v\u1EADt ph\u1EE5 tr\u1EE3 quan tr\u1ECDng.\nNg\u1EF1a th\u01B0\u1EDDng g\u1EAFn
        v\u1EDBi c\xE1c nh\xE2n v\u1EADt ho\xE0ng t\u1EED, t\u01B0\u1EDBng l\u0129nh
        ho\u1EB7c s\u1EE9 gi\u1EA3 trong c\xE1c t\xEDch truy\u1EC7n l\u1ECBch s\u1EED
        v\xE0 Ph\u1EADt gi\xE1o, \u0111\u1EA3m nhi\u1EC7m ch\u1EE9c n\u0103ng di
        chuy\u1EC3n v\xE0 h\u1ED9 t\u1ED1ng, d\u1EABn d\u1EAFt m\u1EA1ch truy\u1EC7n.
        Con r\u1ED1i h\xECnh ng\u1EF1a c\xF3 \u0111\u01B0\u1EE3c t\u1EA1o h\xECnh
        t\xE1c \u0111\u01A1n gi\u1EA3n h\u01A1n r\u1ED1i h\xECnh ng\u01B0\u1EDDi
        nh\u01B0ng \u0111\xF2i h\u1ECFi k\u1EF9 thu\u1EADt \u0111i\u1EC1u khi\u1EC3n
        ch\xEDnh x\xE1c \u0111\u1EC3 th\u1EC3 hi\u1EC7n \u0111\u1ED9ng t\xE1c \u0111i,
        ch\u1EA1y v\xE0 d\u1EEBng, ph\u1EA3n \xE1nh vai tr\xF2 thi\u1EBFt y\u1EBFu
        th\u1EF1c d\u1EE5ng c\u1EE7a ng\u1EF1a trong x\xE3 h\u1ED9i truy\u1EC1n th\u1ED1ng
        Myanmar"
      objectReference: {fileID: 0}
